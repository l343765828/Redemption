{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redemption.local/pvam/evidence/manifest.schema.json",
  "title": "PVAM immutable evidence attempt manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "validation_status",
    "reason",
    "command",
    "exit_code"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "work_id": {
      "type": "string",
      "pattern": "^WORK-PVAM-[0-9A-Z-]+$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_status": {
      "enum": [
        "PENDING",
        "AVAILABLE",
        "SUPERSEDED"
      ]
    },
    "validation_status": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "PENDING_TEST_ENV",
        "BLOCKED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_archive_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "environment": {
      "type": "object"
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "execution_status": {
      "enum": [
        "NOT_STARTED",
        "EXIT_0",
        "EXIT_NONZERO"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "validation_status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "required": [
          "artifact_status",
          "started_at",
          "finished_at",
          "evidence_links"
        ],
        "properties": {
          "artifact_status": {
            "const": "AVAILABLE"
          },
          "exit_code": {
            "const": 0
          },
          "evidence_links": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
