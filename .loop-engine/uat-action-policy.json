  ],
  "exec_profiles": {
    "python-version": {
      "required_tokens": [
        "exec"
      ],
      "command": [
        "python3",
        "--version"
      ]
    },
    "dask-client-versions": {
      "required_tokens": [
        "exec"
      ],
      "command": [
        "python3",
        "-c",
        "import dask,distributed;print('dask='+dask.__version__);print('distributed='+distributed.__version__)"
      ]
    },
    "dask-scheduler-info": {
      "required_tokens": [
        "exec"
      ],
      "repo_cwd": true,
      "runtime_target": "dask_scheduler",
      "command": [
        "python3",
        "-c",
        "from distributed import Client;import json,sys;c=Client(sys.argv[1],timeout='10s');print(json.dumps(c.scheduler_info(),sort_keys=True,default=str));c.close()"
      ]
    },
    "dask-actor-inventory": {
      "required_tokens": [
        "exec"
      ],
      "repo_cwd": true,
      "runtime_target": "dask_scheduler",
      "command": [
        "python3",
        "-c",
        "from distributed import Client;import json,sys;c=Client(sys.argv[1],timeout='10s');x=c.run_on_scheduler(lambda dask_scheduler: sorted([str(k) for k,v in dask_scheduler.tasks.items() if bool(getattr(v,'actor',False))]));print(json.dumps(x));c.close()"
      ]
    },
    "gpu-runtime-probe": {
      "required_tokens": [
        "exec"
      ],
      "command": [
        "python3",
        "-c",
        "import cupy as cp;print('device_count='+str(cp.cuda.runtime.getDeviceCount()));print('device='+str(cp.cuda.runtime.getDevice()))"
      ]
    },
    "dask-actor-rebuild": {
      "required_tokens": [
        "exec",
        "restart"
      ],
      "command": [
        "python3",
        "-m",
        "User.UserService"
      ],
      "repo_cwd": true
    },
    "runtime-summary": {
      "required_tokens": [
        "exec"
      ],
      "command": [
        "python3",
        "-c",
        "import json,platform,sys;print(json.dumps({'python':sys.version.split()[0],'implementation':platform.python_implementation(),'system':platform.system(),'machine':platform.machine()},sort_keys=True))"
      ]
    },
    "dask-list-datasets": {
      "required_tokens": [
        "exec"
      ],
      "repo_cwd": true,
      "runtime_target": "dask_scheduler",
      "command": [
        "python3",
        "-c",
        "from distributed import Client;import json,sys;c=Client(sys.argv[1],timeout='10s');print(json.dumps(sorted([str(x) for x in c.list_datasets()])));c.close()"
      ]
    }
  },
  "debug_profiles": {
    "host-kernel-summary": {
      "required_tokens": [
        "debug"
      ],
      "command": [
        "chroot",
        "/host",
        "uname",
        "-a"
      ]
    }
  },
