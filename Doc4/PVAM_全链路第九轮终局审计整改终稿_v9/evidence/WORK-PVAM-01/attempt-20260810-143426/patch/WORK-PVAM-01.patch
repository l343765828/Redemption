+            method = load_production_method(relative, class_name, function_name)
+            method.__globals__.update(
+                UserStats=FakeUserStats,
+                PVAmountRunSession=SessionMustNotStart,
+                logger=SilentLogger(),
+            )
+            self.assertIsNone(
+                method(
+                    object(),
+                    period="202608",
+                    user_id="42",
+                    bv=1,
+                    order_id="already-completed",
+                )
+            )
