+    )
+    return PvEventNormalizer(
+        resolver,
+        InMemoryEventRegistry(),
+        InMemoryRefundReversalLedger(),
+    ).normalize_order(
+        {"source_event_id": "O-1", "amount": "1.25", "period_num": 40}
+    )
